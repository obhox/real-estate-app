generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(staff)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedBookings InspectionBooking[] @relation("AssignedTo")
  reviewedBookings InspectionBooking[] @relation("ReviewedBy")
  confirmedAgents  InspectionBooking[] @relation("AgentConfirmedBy")
  notifications    Notification[]
  activities       BookingActivity[]
  messages         BookingMessage[]
  internalNotes    InternalNote[]
  createdReceipts  Receipt[]           @relation("ReceiptCreatedBy")
  transactionsCreated Transaction[] @relation("TransactionCreatedBy")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")
  paymentsConfirmed Payment[] @relation("PaymentConfirmedBy")
  ledgerEntriesRecorded LedgerEntry[] @relation("LedgerRecordedBy")
  statementsCreated Statement[] @relation("StatementCreatedBy")
}

enum Role {
  admin
  staff
  reviewer
  approver
}

model InspectionBooking {
  id String @id @default(cuid())
  ref String @unique // BEL-YYYY-XXXXX

  // Visitor-submitted
  name          String
  email         String
  phone         String?
  preferredDate DateTime
  preferredTime String
  location      String
  agentName     String?

  // Lifecycle status
  status BookingStatus @default(new)

  // Admin fields
  assignedToId    String?
  assignedToUser  User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  internalNote    String?
  rescheduledDate DateTime?
  rescheduledTime String?

  // Company agent assignment
  agentId String?
  agent   Agent?  @relation("BookingAgent", fields: [agentId], references: [id])

  // Post-inspection outcome
  outcome         SaleOutcome?
  leadTemperature LeadTemperature @default(cold)

  // Canonical customer link (nullable during migration/backfill)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Flexible property selection (staff-recorded)
  estate        String?
  plotCode      String?
  unitType      String?
  sqm           Int?
  sqmNeeded     Int?
  selectionType String? // "unit" | "sqm_needed"
  plotQuantity  Int?    // number of plots purchased
  unitPrice     Int?    // price per plot

  // Sale / receipt
  soldPrice       Int?
  discount        Int?
  totalPaid       Int?
  paymentMethod   String?
  paymentHistory  Json? // [{ date, method, amount }]
  soldAt          DateTime?
  receiptSentAt   DateTime?
  receiptUrl      String?

  // Locking — once closed, only reopen can mutate
  lockedAt DateTime?

  // When the inspection actually happened (set by mark_active). record_outcome
  // requires it; the inspections list orders by it.
  inspectedAt DateTime?

  // When the client-submitted subscription form was verified (set by
  // confirm_form). Required after an Interested outcome before Sold/Not Sold.
  formConfirmedAt DateTime?

  // Test-data flag (Phase 1): records marked here never appear in metrics,
  // queues, or default list results. See scripts/mark-test-data.ts.
  isTest Boolean @default(false)

  // Visitor raw text preserved separately from canonical agent assignment
  visitorAgentRaw String?

  // Duplicate pointer (computed, but persisted for fast banner)
  possibleDuplicateOfId String?
  possibleDuplicateOf   InspectionBooking? @relation("DuplicatePointer", fields: [possibleDuplicateOfId], references: [id])
  duplicates            InspectionBooking[] @relation("DuplicatePointer")

  // Agent confirmation audit
  agentConfirmedAt   DateTime?
  agentConfirmedById String?
  agentConfirmedBy   User? @relation("AgentConfirmedBy", fields: [agentConfirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedById String?
  reviewedByUser User? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  notifications Notification[]
  activities    BookingActivity[]
  messages      BookingMessage[]
  internalNotes InternalNote[]
  receipts      Receipt[]
  transaction   Transaction?

  @@index([status])
  @@index([leadTemperature])
  @@index([agentId])
  @@index([assignedToId])
  @@index([lockedAt])
}

enum BookingStatus {
  new
  under_review
  on_hold
  approved
  rescheduled
  active
  closed
}

enum SaleOutcome {
  sold
  interested
  not_sold
}

enum LeadTemperature {
  cold
  warm
  hot
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  bookingId String?
  booking   InspectionBooking? @relation(fields: [bookingId], references: [id])
  read      Boolean  @default(false)
  // Set when the entity behind this notification no longer has an inbox
  // item (work done). The bell counts unresolved + unread only.
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, resolvedAt])
}

// Company agents — staff or hire-purchase partners that can be assigned to unassigned bookings.
model Agent {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String        @unique
  category  AgentCategory @default(staff)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  bookings InspectionBooking[] @relation("BookingAgent")
  receipts Receipt[]

  @@index([category])
  @@index([isActive])
  @@index([email])
}

enum AgentCategory {
  staff
  hire_purchase
}

// Canonical customer record. Bookings and transactions link here;
// names/phones on those rows remain as snapshots. Email is stored
// lowercased+trimmed, phone normalized to E.164 (+234...).
model Customer {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String?
  secondaryPhones String[] @default([])
  isTest          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings     InspectionBooking[]
  transactions Transaction[]

  @@index([phone])
}

// Internal messaging thread per booking — visible until booking closed, then read-only.
model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   InspectionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  authorName String
  message   String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// Immutable audit log of every admin action taken on a booking, so the
// booking row itself never has to be the only record of who did what.
model BookingActivity {
  id        String   @id @default(cuid())
  bookingId String
  booking   InspectionBooking @relation(fields: [bookingId], references: [id])

  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String // snapshot at time of action, survives actor deletion

  action     String // approve | reschedule | hold | under_review | mark_active | record_outcome | save | assign_agent | reopen | cool_down | confirm_agent
  fromStatus BookingStatus
  toStatus   BookingStatus
  note       String?

  emailSent  Boolean?
  emailError String?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// Append-only internal notes — each entry timestamped and attributed,
// replacing the old single overwrite "internalNote" textarea.
model InternalNote {
  id         String   @id @default(cuid())
  bookingId  String
  booking    InspectionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([bookingId, createdAt])
}

enum ReceiptSource {
  BOOKING_FLOW
  ADMIN_MANUAL
  PAYMENT_CONFIRMATION
}

model Receipt {
  id String @id @default(cuid())
  ref String @unique // BEL-YYYY-XXXXX unique per payment receipt
  bookingId String?
  booking InspectionBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  paymentId String @unique
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  source ReceiptSource @default(PAYMENT_CONFIRMATION)

  // Snapshot for auditability — denormalized at issue time
  property String // human-readable property line
  estate String?
  plotCode String?
  unitType String?
  sqm Int?
  customerName String
  customerEmail String
  customerPhone String?

  amountBeforeDiscount Int // soldPrice (subtotal = unitPrice * quantity)
  discount Int @default(0)
  finalAmount Int // totalPaid
  amountInWords String
  currency String @default("NGN")
  paymentDescription String // Estate · Unit · Plot
  paymentMethod String?
  paymentHistory Json? // array of {date, method, amount}
  unitPrice Int? // price per plot
  plotQuantity Int? // number of plots
  paymentPlanCode String?
  paymentPlanName String?

  agentId String?
  agent Agent? @relation(fields: [agentId], references: [id])
  agentName String?

  issuedAt DateTime
  sentAt DateTime?
  recipientEmail String
  receiptUrl String
  qrTargetUrl String
  pdfPath String? // public/receipts/{ref}.pdf

  // PDF build state (payment stays CONFIRMED even if this fails)
  pdfStatus String @default("PENDING") // PENDING | GENERATED | FAILED

  // Tokenized client access: the QR code and client URL carry this token,
  // never the receipt ref. Revoking hides the receipt without deleting it.
  accessToken String? @unique
  accessTokenRevokedAt DateTime?
  // Void marking: wrong receipts are VOIDED, never deleted or rewritten.
  // The stored PDF stays exactly as issued (evidence); the public page shows
  // a VOID banner with a link to the replacement. Set by the Correct action.
  voidedAt DateTime?
  replacedByReceiptId String?
  replacedBy Receipt? @relation("ReceiptReplacement", fields: [replacedByReceiptId], references: [id], onDelete: SetNull)
  replacements Receipt[] @relation("ReceiptReplacement")
  // Minimal permanent email proof (Step 1): Resend's message id for this
  // receipt's latest send. Deep-links to the Resend dashboard (30-day log
  // retention); afterwards this id + sentAt + recipientEmail are the proof.
  // Failures are never recorded here — not-emailed is simply sentAt == null.
  resendEmailId String?
  // Stored PDF bytes: rendered once at payment confirmation, reused for
  // every send and download. Resends never regenerate — only an explicit
  // "Regenerate & resend" rebuilds. Null for rows predating this column
  // (render-on-demand fallback). Never selected except by the sender and
  // the PDF download routes (omit everywhere else — ~800KB per row).
  pdfData Bytes?

  createdById String?
  createdBy User? @relation("ReceiptCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerEmail])
  @@index([estate])
  @@index([issuedAt])
  @@index([bookingId])
}

enum TransactionStatus {
  DRAFT
  ACTIVE
  PAID_IN_FULL
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  DUE
  PAID
  PARTIALLY_PAID
  OVERDUE
  WAIVED
}

enum InstallmentType {
  INITIAL
  MONTHLY
}

model PaymentPlan {
  id String @id @default(cuid())
  code String @unique // OUTRIGHT, 3M, 6M
  name String
  durationMonths Int // 0, 3, 6
  interestRate Decimal @db.Decimal(5,2) // 0, 5.00
  interestMethod String // NONE, ONE_TIME_PERCENTAGE
  initialPaymentPercentage Int // 100, 50
  remainingInstallments Int // 0, 3, 6
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Transaction {
  id String @id @default(cuid())
  ref String @unique // TXN-YYYY-XXXXX
  bookingId String? @unique
  booking InspectionBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerName String
  customerEmail String
  customerPhone String?
  estate String
  plotCode String?
  unitType String?
  sqm Int?
  plotQuantity Int @default(1)
  unitPrice Int
  baseAmount Int // unitPrice * plotQuantity
  paymentPlanId String
  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  interestRate Decimal @db.Decimal(5,2)
  interestMethod String
  interestAmount Int @default(0)
  totalPayable Int
  totalPaid Int @default(0)
  outstandingBalance Int
  status TransactionStatus @default(ACTIVE)
  // Test-data flag (Phase 1): excluded from every metric, list default,
  // search result and queue. See scripts/mark-test-data.ts.
  isTest Boolean @default(false)
  // Canonical customer link (nullable during migration/backfill)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Contract (sale) date: the effective date of the charge entries. Set at
  // creation to the creation date; corrected to the real sale date by admin
  // action with an audit entry (fixes statement ordering).
  contractDate DateTime?
  // Why this transaction exists without a booking (required when bookingId
  // is null — enforced server-side; legacy rows predate the rule).
  manualReason String?
  createdById String?
  createdBy User? @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  installments Installment[]
  payments Payment[]
  receipts Receipt[]
  ledgerEntries LedgerEntry[]
  statements Statement[]
  @@index([status])
  @@index([customerEmail])
  @@index([estate])
  @@index([paymentPlanId])
}

model Installment {
  id String @id @default(cuid())
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  installmentNumber Int // 0 for initial, 1..n for monthly
  type InstallmentType
  dueDate DateTime
  scheduledAmount Int
  paidAmount Int @default(0)
  status InstallmentStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  allocations PaymentAllocation[]
  @@index([transactionId, installmentNumber])
  @@index([status])
  @@index([dueDate])
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  CONFIRMED
  FAILED
  CANCELLED
  WAIVED
}

model Payment {
  id String @id @default(cuid())
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  installmentId String?
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  paymentReference String @unique // PAY-YYYY-XXXXX (backfilled; generator-required, no default)
  amount Int
  // Effective calendar date (Africa/Lagos), stored as a date-only value so no
  // timezone can shift it between panels. Always formatted with the shared
  // formatDateDMY helper (explicit zone), never server-local getters.
  paymentDate DateTime @db.Date
  paymentMethod String?
  bankReference String?
  notes String?
  status PaymentStatus @default(PENDING_VERIFICATION)
  recordedById String?
  recordedBy User? @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  confirmedAt DateTime?
  confirmedById String?
  confirmedBy User? @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  verificationNotes String?
  source String? // MANUAL, BOOKING_FLOW, etc.
  // Client-generated idempotency key (one UUID per form open). A repeat
  // submission with the same key returns the existing row instead of
  // minting a duplicate. Replaces the old 60-second time-window dedupe.
  idempotencyKey String? @unique
  // Explicit overpayment: amount above the outstanding balance, recorded as a
  // visible credit balance (never silently truncated). Allocations cover only
  // the schedulable portion; creditAmount is the remainder.
  isCredit Boolean @default(false)
  creditAmount Int?
  // Correction linkage: a replacement payment points at the original it
  // supersedes (voided via the Correct action, never edited in place).
  correctsPaymentId String?
  correctsPayment Payment? @relation("PaymentCorrection", fields: [correctsPaymentId], references: [id], onDelete: SetNull)
  corrections Payment[] @relation("PaymentCorrection")
  // Verification note: bank-statement line evidence ("checked against bank
  // statement line dated ..., confirmed by ...") and reconcile ticks.
  // Appended, never overwritten.
  verificationNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipt Receipt?
  ledgerEntry LedgerEntry?
  allocations PaymentAllocation[]
  @@index([transactionId])
  @@index([installmentId])
  @@index([status])
}

// Append-only money ledger (Step 2). One row per economic event on a
// transaction; balances derive from these rows, never typed in.
// - type: CHARGE_BASE | CHARGE_INTEREST | CHARGE_FEE | PAYMENT | DISCOUNT |
//   WAIVER | ADJUSTMENT | REVERSAL (TEXT by design — new types must not
//   require an enum migration).
// - amount is always a positive whole-naira Int (CHECK amount > 0).
// - direction DEBIT increases what the client owes (charges, reversals of
//   payments); CREDIT decreases it (payments, discounts, waivers).
// - Only CONFIRMED payments get a PAYMENT entry (effectiveDate = paymentDate,
//   so backdated payments land correctly). PENDING payments live only in the
//   Payment table. A voided payment gets a REVERSAL entry pointing at the
//   original via reversesEntryId — rows are never edited or deleted.
// - paymentId is set (and unique) on PAYMENT entries only: every confirmed
//   payment has exactly one ledger entry.
// - idempotencyKey is unique: replays and backfill reruns are safe no-ops.
// Invariants (see src/lib/finance/ledger.ts):
//   totalPayable = sum(CHARGE_*) - sum(DISCOUNT) - sum(WAIVER)
//   totalPaid    = sum(PAYMENT) - sum(REVERSAL of payments)
//   outstanding  = totalPayable - totalPaid
model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  type String
  amount Int
  direction String // DEBIT | CREDIT
  effectiveDate DateTime
  paymentId String? @unique
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  method String?
  bankReference String?
  reversesEntryId String?
  reversesEntry LedgerEntry? @relation("EntryReversal", fields: [reversesEntryId], references: [id], onDelete: SetNull)
  reversals LedgerEntry[] @relation("EntryReversal")
  recordedById String?
  recordedBy User? @relation("LedgerRecordedBy", fields: [recordedById], references: [id])
  note String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([transactionId, type])
  @@index([effectiveDate])
}

// Waterfall allocation rows (Step 2): how each confirmed payment's amount
// was applied across installments (oldest unpaid first). Makes installment
// status explainable: status derives from sum(allocations), never typed in.
// Invariant: sum(allocations per payment) == payment amount.
model PaymentAllocation {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  amount Int
  createdAt DateTime @default(now())

  @@unique([paymentId, installmentId])
  @@index([installmentId])
}

// Stored statement of account (Part B). Immutable once issued: the PDF bytes
// are stored with a statement number (STM-YYYY-XXXXX) and an unguessable
// public token (/s/<token>). Generating again with an unchanged ledger
// returns the existing row; a changed ledger creates a new one. Minimal
// email proof only (emailSentAt/emailRecipient/resendEmailId) — sends happen
// exclusively through the explicit admin Email action, never automatically.
model Statement {
  id String @id @default(cuid())
  number String @unique // STM-YYYY-XXXXX
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  token String @unique
  tokenRevokedAt DateTime?
  pdfData Bytes
  closingBalance Int
  ledgerHash String
  // LEDGER = the staff/internal Statement of Account (ledger order).
  // SCHEDULE = the client-facing Schedule Statement (one row per installment).
  // The two share the issue/token/serve/email lifecycle but never the same
  // dedupe key, so a schedule issue can never return a ledger statement.
  kind String @default("LEDGER")
  asAt DateTime @default(now())
  // Statement template build: as-of date, renderer version and PDF integrity.
  // Nullable so pre-existing rows stay valid. pdfData bytes remain the private
  // store (never under public/); no pdfStorageKey — see issueStatement.
  asOfDate DateTime?
  layoutVersion String?
  pdfSha256 String?
  emailSentAt DateTime?
  emailRecipient String?
  resendEmailId String?
  createdById String?
  createdBy User? @relation("StatementCreatedBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([transactionId, ledgerHash])
  @@index([transactionId, kind, ledgerHash])
}

// Immutable audit trail for payment/transaction/receipt mutations.
// Bookings keep using BookingActivity; this covers everything else.
// Rows are written inside the same DB transaction as the change.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String   @default("System")
  action     String // payment.confirm | payment.void | payment.record |
                    // transaction.create | receipt.send | receipt.resend
  entityType String // payment | transaction | receipt
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
